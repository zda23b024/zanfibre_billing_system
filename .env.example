# Host ports (maps to the nginx container)
HTTP_PORT=80
HTTPS_PORT=443
TZ=UTC

# Browser origins allowed to call the API (comma-separated). Required in production.
# Docker Compose defaults this for local https://localhost access; override for your domain.
# CORS_ORIGIN=https://manager.example.com,http://localhost:3000

# Database
DB_PASSWORD=mikrotik_secure_pw

# JWT Authentication (change to a long random string)
JWT_SECRET=changeme_use_a_long_random_secret_at_least_32_chars

# Device password encryption key (must be exactly 32 characters)
ENCRYPTION_KEY=changeme32byteslongencryptionkey

# InfluxDB
INFLUXDB_TOKEN=mytoken123456789
INFLUXDB_ORG=mikrotik-manager
INFLUXDB_BUCKET=metrics
INFLUXDB_ADMIN_PASSWORD=admin_password_123

# Customer billing portal
BILLING_ENABLED=true
DEFAULT_CURRENCY=TZS
PAYMENT_PROVIDER=manual_mixx
SMS_PROVIDER=console
CUSTOMER_PORTAL_BASE_URL=https://your-domain.example.com/portal

# Manual Mixx payment display. Admin confirms payments from the Billing page.
MIXX_MERCHANT_NUMBER=18198639
MIXX_MERCHANT_NAME=IBRAHIM YAHYA ALLY
MIXX_QR_IMAGE_PATH=

# Selcom production payment gateway (optional later upgrade)
SELCOM_BASE_URL=https://api.selcom.business
SELCOM_VENDOR_ID=
SELCOM_API_KEY=
SELCOM_SECRET_KEY=
SELCOM_CALLBACK_URL=https://your-domain.example.com/api/payments/selcom/callback
SELCOM_REDIRECT_URL=https://your-domain.example.com/portal/payment/pending


# Africa's Talking SMS provider (for later production use)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
